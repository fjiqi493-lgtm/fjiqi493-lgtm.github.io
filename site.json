                "title": "\u5c11\u5373\u662f\u591a",
                "text": "\u6bcf\u4e2a\u4ea7\u54c1\u90fd\u5e94\u5728\u529f\u80fd\u4e0e\u5f62\u6001\u4e4b\u95f4\u627e\u5230\u6700\u7b80\u5e73\u8861\u3002\u53bb\u6389\u591a\u4f59\u7684\u88c5\u9970\uff0c\u8ba9\u6750\u8d28\u548c\u6bd4\u4f8b\u81ea\u5df1\u8bf4\u8bdd\u3002"
            },
            {
                "num": "02",
                "title": "\u4e3a\u91cf\u4ea7\u8bbe\u8ba1",
                "text": "\u597d\u770b\u7684\u6982\u5ff5\u56fe\u53ea\u662f\u8d77\u70b9\u3002\u6bcf\u4e00\u7b14\u7ebf\u6761\u90fd\u8981\u8003\u8651\u7ed3\u6784\u53ef\u884c\u6027\u3001CMF \u6210\u672c\u4e0e\u4f9b\u5e94\u94fe\u7ea6\u675f\u3002"
            },
            {
                "num": "03",
                "title": "\u4ece\u7528\u6237\u51fa\u53d1",
                "text": "\u4e0d\u4e3a\u4e86\u8bbe\u8ba1\u800c\u8bbe\u8ba1\u3002\u5148\u7406\u89e3\u8c01\u5728\u7528\u3001\u5728\u4ec0\u4e48\u573a\u666f\u7528\u3001\u4e3a\u4ec0\u4e48\u9700\u8981\u5b83\uff0c\u518d\u52a8\u7b2c\u4e00\u7b14\u3002"
            }
        ],
        "quote": "\u597d\u7684\u5de5\u4e1a\u8bbe\u8ba1\u662f\u9690\u5f62\u7684\u2014\u2014\u4f60\u611f\u89c9\u4e0d\u5230\u5b83\u7684\u5b58\u5728\uff0c\u4f46\u79bb\u5f00\u5b83\u53c8\u4e0d\u884c\u3002"
