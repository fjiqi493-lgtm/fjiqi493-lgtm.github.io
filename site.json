        "philosophy": {
            "en": "PHILOSOPHY",
            "title": "Design Philosophy",
            "items": [
                {
                    "num": "01",
                    "title": "Less is More",
                    "text": "Every product should strike the simplest balance between function and form. Strip away excess ornament and let material and proportion speak for themselves."
                },
                {
                    "num": "02",
                    "title": "Design for Production",
                    "text": "A pretty concept render is only the start. Every line must consider structural feasibility, CMF cost and supply-chain constraints."
                },
                {
                    "num": "03",
                    "title": "Start with the User",
                    "text": "Never design for design's sake. Understand who uses it, in what context, and why they need it\u2014before the first stroke."
                }
            ],
            "quote": "Good industrial design is invisible\u2014you never notice it, yet you can't do without it."
        },
